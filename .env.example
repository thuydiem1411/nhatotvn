# Chotot MySQL (optional). When MYSQL_HOST + MYSQL_DATABASE are set, or CHOTOT_USE_MYSQL=true,
# crawler, /api/ads, and image backup use the database instead of per-area JSON files.
CHOTOT_USE_MYSQL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=roomlisting_chotot

# Phone fallback behavior
# true: when direct get phone fails (including hidden/expired), run Theia fallback
# false: do not run Theia fallback
PHONE_FALLBACK_THEIA=true

# Crawler cron (server-chotot.js)
ENABLE_CRONJOB=false
