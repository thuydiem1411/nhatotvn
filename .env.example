# Cloudinary Multi-Account Configuration
# Add multiple accounts (free tier: 25GB each)

# Account 1
CLOUDINARY_CLOUD_NAME_1=your_cloud_name_1
CLOUDINARY_API_KEY_1=your_api_key_1
CLOUDINARY_API_SECRET_1=your_api_secret_1

# Account 2
CLOUDINARY_CLOUD_NAME_2=your_cloud_name_2
CLOUDINARY_API_KEY_2=your_api_key_2
CLOUDINARY_API_SECRET_2=your_api_secret_2

# Account 3
CLOUDINARY_CLOUD_NAME_3=your_cloud_name_3
CLOUDINARY_API_KEY_3=your_api_key_3
CLOUDINARY_API_SECRET_3=your_api_secret_3

# Add more accounts as needed...

# Media backup options
# true  -> include videos in backup metadata
# false -> ignore videos (only images are processed)
BACKUP_VIDEOS=false

# Minimum remaining credits to keep per Cloudinary account.
# When an account has <= this number of credits left, it will be skipped
# and the backup process will rotate to the next account.
# Default (if not set): 0.5
CLOUDINARY_MIN_REMAINING_CREDITS=0.5

# Cronjob control
# true  -> enable automatic cronjob execution
# false -> disable cronjob (manual execution only)
ENABLE_CRONJOB=true